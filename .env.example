# Copy to .env and fill in your values:
#   cp .env.example .env

# Minimal runtime config.
# For a full variable reference, see docs/environment-variables.md

# ── Required ──────────────────────────────────────────────────────────────────
TZ=UTC
POSTGRES_USER=homekit
# IMPORTANT: change this to a strong random password before deploying.
# Generate one with: openssl rand -hex 16
POSTGRES_PASSWORD=changeme
POSTGRES_DB=homekit_events

# ── Ports ─────────────────────────────────────────────────────────────────────
# Web UI host port (http://<host>:WEB_PORT).
WEB_PORT=3000
# Postgres host port (bound to localhost by default in compose).
POSTGRES_PORT=5432
# Listener API port.
API_PORT=3001
# Optional: web proxy target port; if unset, compose reuses API_PORT.
# LISTENER_PORT=3001

# ── Persistent data mounts ────────────────────────────────────────────────────
# Postgres data mount source. Use a named volume (`postgres-data`) or an
# absolute host path (example: /mnt/tank/apps/homechronicle/postgres).
POSTGRES_DATA_SOURCE=postgres-data
# Listener /app/data mount source. For local compose, `./listener/data` keeps
# files in the repo. In Portainer/TrueNAS, prefer an absolute host path or a
# named volume such as `listener-data`.
LISTENER_DATA_SOURCE=./listener/data

# ── Common optional overrides ────────────────────────────────────────────────
# Linux host deployments: mount host D-Bus so discovery can use host avahi-daemon.
# On most systems this is /run/dbus/system_bus_socket.
HOST_DBUS_SOCKET=/run/dbus/system_bus_socket
# Optional: force discovery to a specific interface (example: bond0, eno1).
# DISCOVER_IFACE=bond0
# Optional: HomeKit request/pairing timeouts (ms). A device that accepts a
# connection but never answers is dropped and reconnected instead of hanging.
# HAP_REQUEST_TIMEOUT_MS=30000
# HAP_PAIR_TIMEOUT_MS=60000
# Listener network mode (`host` recommended for mDNS/HomeKit/Matter on Linux).
LISTENER_NETWORK_MODE=host
# Web -> listener proxy target for host-network listener.
LISTENER_HOST=host.docker.internal
# If your Docker engine does not support `host-gateway`, set LISTENER_HOST to the
# Docker host LAN IP instead (example: 192.168.1.20).
# Fallback example:
# LISTENER_HOST=192.168.1.20
# Bridge-mode fallback (no host networking):
# LISTENER_NETWORK_MODE=bridge
# LISTENER_HOST=listener
# Required in production: set API_TOKEN to a long random secret.
# Generate one with: openssl rand -hex 32
API_TOKEN=
# Optional: bind address for the listener API. Defaults to 0.0.0.0 (all interfaces).
# Set to 127.0.0.1 to restrict access to localhost only.
# API_BIND_ADDRESS=0.0.0.0
# Optional: also require API_TOKEN on GET/HEAD routes.
# API_TOKEN_READS_ENABLED=false
# Optional: comma-separated CORS origin allow-list (example: https://home.example.com,http://localhost:5173).
# If empty, only localhost browser origins are allowed by default.
# CORS_ALLOWED_ORIGINS=
# Set false to disable localhost fallback when CORS_ALLOWED_ORIGINS is empty.
# CORS_ALLOW_LOCALHOST=true
# Maximum JSON body size accepted by the listener API.
# API_JSON_LIMIT=256kb
# Rate limit tuning (per-client, per-window) for DB-backed API routes.
# API_WRITE_RATE_LIMIT_WINDOW_MS=60000
# API_WRITE_RATE_LIMIT_MAX=60
# API_STATS_RATE_LIMIT_WINDOW_MS=60000
# API_STATS_RATE_LIMIT_MAX=120
# EVENTS_RATE_LIMIT_WINDOW_MS=60000
# EVENTS_RATE_LIMIT_MAX=300
# Days to keep alert delivery records (default: 90).
# ALERT_RETENTION_DAYS=90

# ── Multi-user auth (Phase 20) ───────────────────────────────────────────────
# Set AUTH_ENABLED=false to disable the session/user system and revert to the
# legacy API_TOKEN-only gate (v1.3 behavior). Default: true.
# AUTH_ENABLED=true
# Set SESSION_COOKIE_SECURE=true for HTTPS deployments so the hc_session cookie
# is only sent over encrypted connections. NEVER derived from NODE_ENV (SEC-01).
# For self-hosted HTTP (e.g., on a home LAN): leave false (the default).
# SESSION_COOKIE_SECURE=false
# Session lifetime in milliseconds. Default: 7 days (604800000 ms).
# SESSION_MAX_AGE_DEFAULT=604800000
# Lifetime when "remember me" is checked at login. Default: 30 days (2592000000 ms).
# SESSION_MAX_AGE_REMEMBER=2592000000
# argon2id memory cost in KiB (default: 65536 = 64 MiB).
# ARGON2_MEMORY_COST=65536
# argon2id time cost in iterations (default: 3).
# ARGON2_TIME_COST=3
# Auth endpoint rate limit tuning (login + claim-admin endpoints).
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10
# Reverse-proxy hop count for Express `trust proxy`: the number of proxies
# between the client and the listener that append to X-Forwarded-For. UNSET
# by default: req.ip is the direct socket address (correct for direct exposure
# / dev). Set TRUST_PROXY=1 for the bundled nginx alone (the stock compose
# topology). Set TRUST_PROXY=2 when a TLS terminator (Traefik, Caddy,
# Cloudflare Tunnel, another nginx) sits in front of the bundled nginx —
# nginx always appends its own hop, so the terminator makes it two. Too LOW
# keys the limiter on the proxy's address, collapsing every client into one
# bucket (10 failed logins from anyone locks out the whole household); too
# HIGH walks past the real client into attacker-controlled header territory.
# Also accepts true/false or a subnet / 'loopback'.
# TRUST_PROXY=1

# ── matter.js SDK logging ─────────────────────────────────────────────────────
# Separate from the listener's own LOG_LEVEL, which controls listener/src/logger.js output.
# The matter.js SDK default is debug, which dumps full inspected objects (certificates,
# ACLs, fabric data, hex payloads) for every Matter packet — extremely CPU-intensive.
# Valid levels: debug | info | notice | warn | error | fatal (default: info).
# MATTER_LOG_LEVEL=info
# ANSI escape codes do not render in Docker logs and waste CPU and bytes.
# Valid formats: plain | ansi | html (default: plain).
# MATTER_LOG_FORMAT=plain

# ── Matter event transport ────────────────────────────────────────────────────
# By default the listener SUBSCRIBES to Matter attribute changes: the device
# reports when something changes, rather than being asked every few seconds.
# That is lower latency, far less network traffic, and much kinder to
# battery-powered Thread devices.
#
# A subscription can stall silently, so a slow reconciliation poll runs
# alongside it and re-reads every attribute periodically. A stalled
# subscription therefore degrades to delayed events, never to silence.
#
# Set to false to fall back to polling only (the pre-0.4 behaviour).
# MATTER_SUBSCRIBE_ENABLED=true
#
# How often the safety-net poll re-reads a SUBSCRIBED node. Its job is to catch
# a dead subscription, not to be the transport, so keep it slow. Floored at 30s.
# MATTER_RECONCILE_INTERVAL_MS=300000
#
# Poll interval used when MATTER_SUBSCRIBE_ENABLED=false, where polling is the
# only source of readings. Floored at 1000ms.
# MATTER_POLL_INTERVAL_MS=5000
#
# Subscription report interval bounds, in seconds. max is how long a device may
# stay silent before sending a keepalive: lower means faster detection of a dead
# node, higher means less radio traffic and longer battery life.
# MATTER_SUBSCRIBE_MIN_INTERVAL_SEC=1
# MATTER_SUBSCRIBE_MAX_INTERVAL_SEC=30
#
# Backoff base for re-establishing a dropped subscription (doubles, capped 5min).
# MATTER_SUBSCRIBE_RESTART_DELAY_MS=2000

# ── Email (SMTP) — Phase 21 ───────────────────────────────────────────────────
# All SMTP variables are optional. If SMTP_HOST or SMTP_PASS is not set, email
# features are disabled and the listener boots normally (graceful degradation).
# Environment variable values override any SMTP settings saved via the Settings UI (D-02).
#
# SMTP server hostname (e.g. smtp.fastmail.com, smtp.gmail.com).
# SMTP_HOST=
# SMTP port. Use 587 for STARTTLS (default) or 465 for implicit TLS.
# SMTP_PORT=587
# SMTP account username (usually your email address or login name).
# SMTP_USER=
# SMTP account password or app-password. Stored in smtp-secret.json (0600 perms);
# never returned by any API response. This env var overrides the stored secret.
# SMTP_PASS=
# From header for outbound emails (e.g. 'HomeChronicle <noreply@yourdomain>').
# SMTP_FROM=
# Set true only when using port 465 (implicit TLS). Leave unset for port 587 STARTTLS.
# SMTP_SECURE=false
# Require the server to support STARTTLS before AUTH is attempted on a plaintext
# (non-465) connection. Default true — a relay that does not advertise or complete
# STARTTLS will fail the connection rather than sending the SMTP password in
# cleartext. Set to false ONLY for a legacy relay that cannot do TLS at all — in
# that case the SMTP password travels in cleartext.
# SMTP_REQUIRE_TLS=true
# Public base URL of this HomeChronicle instance — used to build invite and
# password-reset links in outgoing emails. Must include scheme and host, no trailing slash.
# Example: https://home.example.net
# APP_BASE_URL=

# ── Beta db-sync (prod → beta refresh on deploy) ──────────────────────────────
# These belong in the BETA stack's env file (.env.beta) on the Dockhand host,
# NOT in production .env. The `db-sync` one-shot service in docker-compose.beta.yml
# refreshes beta's Postgres from a prod snapshot on each (re)created deploy.
# This is DEPLOY-TIME refresh only — the scripts/sync-beta-auto.sh host cron can
# remain as the optional nightly top-up. Beta DB creds (BETA_DB_PASSWORD) already
# exist above and are unchanged.
#
# Prod postgres host as seen from the host-mode db-sync container (loopback).
# PROD_DB_HOST=127.0.0.1
# Prod postgres loopback-published port.
# PROD_DB_PORT=5432
# Prod POSTGRES_USER.
# PROD_DB_USER=homekit
# Prod POSTGRES_DB.
# PROD_DB_NAME=homekit_events
# Prod POSTGRES_PASSWORD. NEW SECRET for beta: the network sync path (pg_dump over
# TCP) cannot inherit prod's container creds the way the old `docker exec` host
# script did, so prod's password must be supplied explicitly here.
# PROD_DB_PASSWORD=
# Failure policy. false (default) = best-effort: a prod outage / sync failure logs
# loudly but still lets the beta listener start with prior/empty data. true = a
# sync failure blocks the deploy (db-sync exits non-zero, listener never starts).
# SYNC_REQUIRED=false
