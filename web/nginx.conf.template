# Custom log format: mirrors the nginx default "combined" format but replaces
# $request (which includes the query string) with "$request_method $uri$is_args"
# to strip query strings from the logged URL. Used for /api/auth/* locations so
# invite/reset tokens (?token=...) never appear in access logs (Pitfall 2 / P6).
# log_format must be declared at http{} scope — this file is included via
# include /etc/nginx/conf.d/*.conf inside the http{} block in nginx.conf,
# so this directive is correctly placed.
log_format combined_no_query '$remote_addr - $remote_user [$time_local] '
                              '"$request_method $uri$is_args" $status $body_bytes_sent '
                              '"$http_referer" "$http_user_agent"';

# M-12: pass an inbound X-Forwarded-Proto through instead of unconditionally
# overwriting it with $scheme. Behind a TLS terminator (Traefik/Caddy/
# Cloudflare Tunnel) in front of this nginx, $scheme on the Traefik->nginx
# leg is "http" even though the client connected over HTTPS — overwriting
# with $scheme would report the wrong scheme upstream. Falls back to $scheme
# only when no inbound header is present (direct exposure / dev).
#
# Trust note: the inbound header is accepted here only because nothing in the
# listener currently makes a security decision on X-Forwarded-Proto. A LAN
# client hitting port 3000 directly can set this header to whatever it wants.
# If SESSION_COOKIE_SECURE or any redirect logic ever reads it, this map must
# be narrowed to trusted upstreams first (real_ip/set_real_ip_from, or an
# allow-list map) — see docs/guide/security.md.
map ${DOLLAR}http_x_forwarded_proto ${DOLLAR}hc_forwarded_proto {
    default ${DOLLAR}http_x_forwarded_proto;
    ''      ${DOLLAR}scheme;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Re-resolve the listener upstream per request so a recreated listener
    # container (new IP) self-heals instead of 502-ing this long-lived web
    # container. NGINX_RESOLVER is injected at container start via envsubst
    # (Docker embedded DNS 127.0.0.11 by default). Harmless/unused in
    # host-network mode where LISTENER_HOST is an IP literal (never queried).
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'" always;

    location = / {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files /index.html =404;
    }

    location = /index.html {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = /service-worker.js {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # React SPA - serve index.html for any non-file route
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy /api/* to the listener.
    # LISTENER_HOST is injected at container start via envsubst:
    #   - local dev (bridge network): "listener"  (Docker DNS)
    #   - NAS (host network):         "127.0.0.1"

    # Matter commissioning endpoints need extended timeout (2+ minutes).
    location ~ ^/api/setup/(pair|matter/pair) {
        set ${DOLLAR}hc_listener ${LISTENER_HOST};
        proxy_pass http://${DOLLAR}hc_listener:${LISTENER_PORT};
        proxy_set_header X-API-Token "${NGINX_API_TOKEN}";
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}hc_forwarded_proto;
        proxy_read_timeout 300s;
    }

    # Auth routes: use query-string-free log format so invite/reset tokens
    # (?token=...) never appear in access logs (Pitfall 2 / P6 / T-21-07-TOKENLOG).
    # Proxy directives are identical to the generic /api/ block (X-API-Token injection
    # preserved for Phase 23 cutover — T-21-07-CUTOVER).
    location ~ ^/api/auth/ {
        access_log /var/log/nginx/access.log combined_no_query;
        set ${DOLLAR}hc_listener ${LISTENER_HOST};
        proxy_pass http://${DOLLAR}hc_listener:${LISTENER_PORT};
        proxy_set_header X-API-Token "${NGINX_API_TOKEN}";
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}hc_forwarded_proto;
        proxy_read_timeout 30s;
    }

    # All other API routes use a shorter timeout.
    location /api/ {
        set ${DOLLAR}hc_listener ${LISTENER_HOST};
        proxy_pass http://${DOLLAR}hc_listener:${LISTENER_PORT};
        proxy_set_header X-API-Token "${NGINX_API_TOKEN}";
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}hc_forwarded_proto;
        proxy_read_timeout 30s;
    }
}
