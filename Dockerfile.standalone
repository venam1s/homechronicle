# ─────────────────────────────────────────────────────────────────────────────
# homechronicle — all-in-one standalone image
# Bundles PostgreSQL 16, the Node.js listener, and Nginx into a single
# container so users can run everything with one `docker run` command.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: build listener dependencies (native addons) ────────────────────
FROM node:22-trixie-slim AS listener-build

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ \
    libavahi-compat-libdnssd-dev \
    libbluetooth-dev \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY listener/package.json .
COPY listener/package-lock.json .
# Mirrors listener/Dockerfile:15 — must precede npm ci so postinstall:
# patch-package (a production dependency, so it runs under --omit=dev) finds
# the dnssd cycle-guard patch instead of silently applying nothing (H-5).
COPY listener/patches/ ./patches/
RUN npm ci --omit=dev

# ── Stage 2: build web UI ───────────────────────────────────────────────────
FROM node:20-alpine AS web-build

WORKDIR /build
COPY web/package.json .
COPY web/package-lock.json .
RUN npm ci

COPY web/ .

ARG VITE_BUILD_VERSION=unknown
ENV VITE_BUILD_VERSION=$VITE_BUILD_VERSION
# In standalone mode the web UI is served from the same origin, so no
# explicit API base URL is needed (requests go to /api/* on the same host).
ENV VITE_API_BASE_URL=

RUN npm run build

# ── Stage 3: runtime ────────────────────────────────────────────────────────
FROM node:22-trixie-slim

LABEL org.opencontainers.image.title="homechronicle Standalone" \
      org.opencontainers.image.description="All-in-one homechronicle: PostgreSQL + Listener + Web UI" \
      org.opencontainers.image.source="https://gitlab.com/havuq/homechronicle"

# ── Install PostgreSQL 16, Nginx, supervisord, and runtime libs ─────────────
# PostgreSQL 16 is not in Debian Trixie's default repos — add the PGDG apt
# repository so we get the exact major version we need.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    gnupg curl ca-certificates \
  && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
     | gpg --dearmor -o /usr/share/keyrings/pgdg.gpg \
  && echo "deb [signed-by=/usr/share/keyrings/pgdg.gpg] http://apt.postgresql.org/pub/repos/apt trixie-pgdg main" \
     > /etc/apt/sources.list.d/pgdg.list \
  && apt-get update && apt-get install -y --no-install-recommends \
    postgresql-16 \
    nginx \
    supervisor \
    libavahi-compat-libdnssd1 dbus \
    libbluetooth3 \
    gosu \
    openssl \
    dnsutils iputils-ping \
  && rm -rf /var/lib/apt/lists/*

# ── Listener ────────────────────────────────────────────────────────────────
# Set ownership at COPY time. Doing `COPY` then `RUN chown -R` is dramatically
# slower because it walks every file in node_modules (~10K+ inodes) and each
# chown triggers an overlay2 copy-up from the lower layer. `--chown=` sets
# ownership in the same layer, near-free. Mirrors listener/Dockerfile.
WORKDIR /app/listener
COPY --from=listener-build --chown=node:node /build/node_modules ./node_modules
COPY --chown=node:node listener/package.json .
COPY --chown=node:node listener/src/ ./src/
# Mirrors listener/Dockerfile:34 — without this, db.js's ../migrations lookup
# (relative to src/) resolves to nothing and the unconditional top-level
# `await migrateDb()` in index.js throws at boot, crash-looping supervisord (H-5).
COPY --chown=node:node listener/migrations/ ./migrations/
RUN mkdir -p /app/listener/data && chown node:node /app/listener/data

# ── Web UI ──────────────────────────────────────────────────────────────────
COPY --from=web-build /build/dist /usr/share/nginx/html
COPY web/nginx.conf.template /etc/nginx/templates/default.conf.template

# Remove default nginx config
RUN rm -f /etc/nginx/sites-enabled/default /etc/nginx/conf.d/default.conf

# ── Supervisord & entrypoint ────────────────────────────────────────────────
COPY docker/standalone/supervisord.conf /etc/supervisord.conf
COPY docker/standalone/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# ── Volumes ─────────────────────────────────────────────────────────────────
# PostgreSQL data and listener persistent data (pairings, rooms, etc.)
VOLUME ["/var/lib/postgresql/data", "/app/listener/data"]

# WEB_PORT is configurable (default 80). In host-network mode, set WEB_PORT
# to avoid conflicts (e.g. WEB_PORT=3000). No TCP port is used for PostgreSQL
# (Unix socket only), so there is no 5432 conflict in host-network mode.
ENV WEB_PORT=80
EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --retries=12 --start-period=40s \
  CMD curl -sf http://127.0.0.1:${WEB_PORT:-80}/api/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
