{
  "name": "homechronicle-listener",
  "version": "1.0.0",
  "description": "Event Logging for Apple HomeKit",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file=../.env src/index.js",
    "dev": "DISCOVER_IFACE=${DISCOVER_IFACE:-en0} DATABASE_URL=${DATABASE_URL:-postgresql://homekit:changeme@localhost:5432/homekit_events} NODE_ENV=${NODE_ENV:-development} node --env-file=../.env src/index.js",
    "discover": "node src/discover.js",
    "pair": "node src/pairing.js",
    "add-pairing": "node src/add-pairing.js",
    "seed": "node src/seed.js",
    "test": "node --test",
    "postinstall": "patch-package"
  },
  "overrides": {
    "picomatch": "2.3.2",
    "path-to-regexp": "8.4.2",
    "tmp": "0.2.7"
  },
  "dependencies": {
    "@matter/main": "^0.17.9",
    "@project-chip/matter.js": "^0.17.9",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-sync": "^4.2.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "hap-controller": "^0.10.2",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^9.0.6",
    "patch-package": "^8.0.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
